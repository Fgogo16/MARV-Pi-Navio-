from picamera2 import Picamera2
from pupil_apriltags import Detector
import numpy as np
import time

# Initialize AprilTag detector
detector = Detector(
    families="tag25h9"
)

# Initialize camera
picam2 = Picamera2()

config = picam2.create_video_configuration(
    main={
        "size": (1536, 864), 
        "format": "YUV420"
    },
    raw=None,
    buffer_count=4
)

try:
    # Configure and start camera
    picam2.configure(config)
    picam2.start()

    time.sleep(2)

    # Capture frame
    frame = picam2.capture_array()

    # Extract grayscale image
    gray = frame[:864, :]

    # Ensure contiguous memory for detector
    gray = np.ascontiguousarray(gray)

    # Detect AprilTags
    detections = detector.detect(gray)

    print("Number of tags:", len(detections))

    for tag in detections:
        print("Tag ID:", tag.tag_id) # Assigned id
        print("Center:", tag.center) # Center of detected quadirlateral
        print("Corners:\n", tag.corners) # Corners of detected quadirlateral

finally:
    if picam2.started:
        picam2.stop()

    picam2.close()