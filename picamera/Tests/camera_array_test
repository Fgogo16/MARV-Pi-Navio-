from picamera2 import Picamera2
import time

picam2 = Picamera2()

config = picam2.create_video_configuration(
    main={
        "size": (1536, 864),
        "format": "YUV420"
    },
    raw=None,
    buffer_count=4
)

try:
    picam2.configure(config)
    picam2.start()

    time.sleep(2)

    # Retrieve a frame as a NumPy array
    frame = picam2.capture_array()

    print("Frame dimensions:", frame.shape)
    print("Data type:", frame.dtype)

finally:
    if picam2.started:
        picam2.stop()

    picam2.close()