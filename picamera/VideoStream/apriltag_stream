
import time
import cv2
import numpy as np

from flask import Flask, Response, render_template_string
from picamera2 import Picamera2
from pupil_apriltags import Detector


# ============================================================
# 1. APPLICATION CONFIGURATION
# ============================================================

# Camera resolution
WIDTH = 1536
HEIGHT = 864

# AprilTag configuration
TAG_FAMILY = "tag25h9"

# Flask configuration
HOST = "0.0.0.0"
PORT = 5000


# ============================================================
# 2. INITIALIZE FLASK
# ============================================================

app = Flask(__name__)


# ============================================================
# 3. INITIALIZE APRILTAG DETECTOR
# ============================================================

detector = Detector(
    families=TAG_FAMILY,
    nthreads=2,
    quad_decimate=2.0,
    quad_sigma=0.0,
    refine_edges=1,
    decode_sharpening=0.25,
    debug=0
)


# ============================================================
# 4. INITIALIZE CAMERA
# ============================================================

picam2 = Picamera2()

camera_config = picam2.create_video_configuration(
    main={
        "size": (WIDTH, HEIGHT),
        "format": "YUV420"
    },
    raw=None,
    buffer_count=4
)

picam2.configure(camera_config)


# ============================================================
# 5. START CAMERA
# ============================================================

picam2.start()

# Allow camera exposure and white balance to stabilize
time.sleep(2)


# ============================================================
# 6. VIDEO PROCESSING FUNCTION
# ============================================================

def generate_frames():

    previous_time = time.perf_counter()

    while True:

        # ----------------------------------------------------
        # A. Capture image from camera
        # ----------------------------------------------------

        frame = picam2.capture_array()

        # ----------------------------------------------------
        # B. Extract grayscale image
        # ----------------------------------------------------

        # YUV420 stores the grayscale/luminance plane first.
        # The remaining rows contain chrominance information.

        gray = frame[:HEIGHT, :]

        # Ensure memory is contiguous for the detector
        gray = np.ascontiguousarray(gray)

        # ----------------------------------------------------
        # C. Detect AprilTags
        # ----------------------------------------------------

        detections = detector.detect(gray)

        # ----------------------------------------------------
        # D. Convert grayscale image to BGR for annotation
        # ----------------------------------------------------

        annotated = cv2.cvtColor(
            gray,
            cv2.COLOR_GRAY2BGR
        )

        # ----------------------------------------------------
        # E. Draw detected AprilTags
        # ----------------------------------------------------

        for tag in detections:

            # Get tag corner coordinates
            corners = tag.corners.astype(int)

            # Draw the tag boundary
            cv2.polylines(
                annotated,
                [corners],
                True,
                (0, 255, 0),
                3
            )

            # Get center coordinates
            center = tag.center.astype(int)

            center_x = center[0]
            center_y = center[1]

            # Draw center point
            cv2.circle(
                annotated,
                (center_x, center_y),
                6,
                (0, 0, 255),
                -1
            )

            # Display tag ID
            cv2.putText(
                annotated,
                f"ID: {tag.tag_id}",
                (center_x, center_y - 20),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.7,
                (0, 255, 0),
                2
            )

            # Display center coordinates
            cv2.putText(
                annotated,
                f"({center_x}, {center_y})",
                (center_x, center_y + 25),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.5,
                (255, 255, 0),
                2
            )

        # ----------------------------------------------------
        # F. Calculate processing FPS
        # ----------------------------------------------------

        current_time = time.perf_counter()

        elapsed_time = current_time - previous_time

        fps = 1.0 / elapsed_time if elapsed_time > 0 else 0.0

        previous_time = current_time

        # Display FPS
        cv2.putText(
            annotated,
            f"FPS: {fps:.1f}",
            (20, 35),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.8,
            (255, 255, 255),
            2
        )

        # Display number of detected tags
        cv2.putText(
            annotated,
            f"Tags detected: {len(detections)}",
            (20, 70),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.8,
            (255, 255, 255),
            2
        )

        # ----------------------------------------------------
        # G. Convert processed image to JPEG
        # ----------------------------------------------------

        success, encoded_image = cv2.imencode(
            ".jpg",
            annotated,
            [cv2.IMWRITE_JPEG_QUALITY, 80]
        )

        if not success:
            continue

        # ----------------------------------------------------
        # H. Send image to Flask as an MJPEG frame
        # ----------------------------------------------------

        yield (
            b"--frame\r\n"
            b"Content-Type: image/jpeg\r\n\r\n"
            + encoded_image.tobytes()
            + b"\r\n"
        )


# ============================================================
# 7. MAIN WEBPAGE
# ============================================================

HTML_PAGE = """
<!DOCTYPE html>
<html>

<head>

    <title>MARV AprilTag Detection</title>

    <style>

        body {
            background-color: #202124;
            color: white;
            font-family: Arial, sans-serif;
            text-align: center;
        }

        h1 {
            margin-top: 25px;
        }

        img {
            width: 90%;
            max-width: 1200px;
            border: 3px solid #4CAF50;
            border-radius: 8px;
        }

    </style>

</head>

<body>

    <h1>MARV AprilTag Detection System</h1>

    <p>Live Raspberry Pi Camera Stream</p>

    <img src="/video_feed">

</body>

</html>
"""


# ============================================================
# 8. FLASK ROUTES
# ============================================================

@app.route("/")
def index():

    return render_template_string(HTML_PAGE)


@app.route("/video_feed")
def video_feed():

    return Response(
        generate_frames(),
        mimetype="multipart/x-mixed-replace; boundary=frame"
    )


# ============================================================
# 9. RUN APPLICATION
# ============================================================

if __name__ == "__main__":

    try:

        print("Starting MARV AprilTag Detection System...")

        print(f"Camera resolution: {WIDTH} x {HEIGHT}")

        print(f"AprilTag family: {TAG_FAMILY}")

        print(f"Server address: http://<RASPBERRY_PI_IP>:{PORT}")

        app.run(
            host=HOST,
            port=PORT,
            debug=False,
            threaded=True
        )

    except KeyboardInterrupt:

        print("Stopping application...")

    finally:

        if picam2.started:
            picam2.stop()

        picam2.close()

        print("Camera resources released.")
